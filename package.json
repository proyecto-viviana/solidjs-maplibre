{
  "name": "@proyecto-viviana/solidjs-maplibre",
  "version": "0.1.1",
  "description": "SolidJS components for MapLibre GL JS",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/proyecto-viviana/solidjs-maplibre#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proyecto-viviana/solidjs-maplibre.git"
  },
  "bugs": {
    "url": "https://github.com/proyecto-viviana/solidjs-maplibre/issues"
  },
  "keywords": [
    "solid",
    "solid-js",
    "solidjs",
    "maplibre",
    "maplibre-gl",
    "maps",
    "webgl"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx",
      "browser": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "node": {
        "import": "./dist/server.js",
        "require": "./dist/server.cjs"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "dev:prototype": "vp dev --config examples/prototype/vite.config.ts --host 127.0.0.1",
    "build:prototype": "vp build --config examples/prototype/vite.config.ts",
    "prepack": "pnpm run build",
    "changeset": "vp exec changeset",
    "changeset:status": "vp exec changeset status --since=origin/main",
    "changeset:version": "vp exec changeset version && pnpm install --lockfile-only --no-frozen-lockfile --ignore-scripts",
    "changeset:publish": "vp run build && vp exec changeset publish",
    "ci:changesets": "node scripts/check-changeset-required.mjs && node scripts/check-changeset-status.mjs",
    "ci:release-readiness": "vp run typecheck && vp run typecheck:test && vp run test && vp run build && vp run test:ssr && vp run typecheck:prototype && vp run build:prototype && pnpm pack --dry-run",
    "release:prepare": "vp run changeset:version && vp run ci:release-readiness",
    "release:npm": "vp run changeset:publish",
    "release:publish": "vp run release:npm",
    "release": "vp run release:prepare && vp run release:publish",
    "release:local": "vp run release",
    "typecheck:prototype": "tsc --noEmit -p examples/prototype/tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "test:ssr": "node test/ssr-build-smoke.mjs",
    "test": "vp test run"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "maplibre-gl": ">=4.0.0",
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@solidjs/testing-library": "^0.8.10",
    "jsdom": "^24.1.3",
    "maplibre-gl": "^5.0.0",
    "solid-js": "^1.8.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.3",
    "unplugin-solid": "^1.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vite-plugin-solid": "^2.10.2",
    "vite-plus": "0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "packageManager": "pnpm@11.0.8",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
      "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
    }
  }
}
